# TLS in front of the API on each server, for servers Cloudflare connects to
# directly (proxied DNS records, no load balancer of your own). Started by the
# `proxy` profile of compose.prod.yaml; the deploy workflow enables it when
# the PUBLIC_HOST variable is set.
#
# Certificate: a Cloudflare Origin CA certificate when the TLS_CERT and
# TLS_KEY secrets are set (works with SSL mode "Full (strict)"); otherwise a
# self-signed one (SSL mode "Full").
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		# https://www.cloudflare.com/ips/ — only these may set the client
		# address, which Cloudflare sends in CF-Connecting-IP.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$PUBLIC_HOST}:443 {
	tls {$CADDY_TLS:internal}
	reverse_proxy api:3000 {
		# One address, the real client: the API trusts this proxy for it.
		header_up X-Forwarded-For {client_ip}
	}
}
