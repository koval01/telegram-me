# Copy to `.env` and adjust. Every variable is optional; see
# https://koval01.github.io/telegram-me/configuration/ for the full list.

# --- Server -----------------------------------------------------------------
# Port inside the container / process.
PORT=3000
# Host port published by compose.yaml.
APP_PORT=8000
# Worker processes (default: CPU count, at most 4).
# WEB_CONCURRENCY=2
# Reverse proxy addresses whose X-Forwarded-For is trusted ("*" = any).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Features ---------------------------------------------------------------
DISABLE_DOCS=false
# Public address for the absolute URLs in /robots.txt and /sitemap.xml.
# PUBLIC_URL=https://tme.example.com
# Documentation served at /docs (the image sets /app/docs; unset: redirect to GitHub Pages).
# DOCS_SITE_DIR=site-instance
ENABLE_PREVIEWS=true
# /v1/feed is heavy and disabled by default.
ENABLE_FEED=false
# --- Protection (both off by default; see docs/api/protection.md) -----------
ENABLE_RATE_LIMIT=false
RATE_LIMIT_RPM=120
# RATE_LIMIT_BURST=120
RATE_LIMIT_SHARED=true
ENABLE_POW=false
# POW_SECRET=   # at least 32 characters, the same on every server: openssl rand -hex 32
POW_DIFFICULTY=18
POW_CHALLENGE_TTL=300
POW_BIND_IP=true
# GraphQL API at /graphql (GraphiQL and introspection follow DISABLE_DOCS)
ENABLE_GRAPHQL=true
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=1500
GRAPHQL_MAX_ALIASES=15
GRAPHQL_MAX_TOKENS=2000
GRAPHQL_MAX_BATCH_SIZE=10

# --- Performance --------------------------------------------------------------
# off | normal | aggressive
CACHE_MODE=normal
# full | simplified
PARSER_MODE=full

# --- Upstream (t.me) ----------------------------------------------------------
# Where pages are fetched from: a mirror, or the fake t.me of the integration tests.
# TELEGRAM_BASE_URL=https://t.me
# browser: TLS, HTTP/2 and headers of one browser profile (wreq, BoringSSL)
# reqwest: the profile's headers over rustls/hyper (fallback)
# TELEGRAM_CLIENT=browser
# TELEGRAM_BROWSER_PROFILE=chrome_149
# android | ios | windows | macos | linux
# TELEGRAM_BROWSER_PLATFORM=android

# --- Cache --------------------------------------------------------------------
# Without REDIS_URL an in-process memory cache is used (per worker).
# compose.yaml points it at the bundled Valkey automatically.
# REDIS_URL=redis://localhost:6379/0
# Command timeout; slower commands open the circuit breaker for 30 s.
REDIS_TIMEOUT=0.5
# Opening a connection, TLS handshake included (longer for distant TLS endpoints).
REDIS_CONNECT_TIMEOUT=2
# Each worker's marker in Redis (keeps a connection open, probes while bypassed); 0 disables.
REDIS_HEARTBEAT_INTERVAL=5

# --- Peers (off by default) ---------------------------------------------------
# Nodes on a private network share their work directly: each key is fetched
# by one node, the others ask it. Works without Redis; see docs/deployment/peers.md.
# ENABLE_PEERS=true
# Same on every node, at least 32 characters (openssl rand -hex 32).
# PEER_SECRET=
# Where to find other nodes: host or host:port, comma-separated (DNS names too).
# PEERS=10.0.0.108,10.0.0.165
# First peer port (UDP and TCP); worker N takes the N-th free one after it.
PEER_PORT=7946
# Address other nodes reach this one at (default: the default route's).
# PEER_ADVERTISE_ADDR=10.0.0.108
# Networks peers may connect from (default: private and loopback ranges).
# PEER_ALLOW_CIDR=10.0.0.0/16
# Also encrypt peer traffic, for networks you do not trust.
PEER_ENCRYPTION=false
# Seconds a peer has to connect and answer before a node does the work itself.
PEER_TIMEOUT=0.05

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# --- compose.yaml -------------------------------------------------------------
# standard | full | minimal (deploy/presets/*.env)
# PRESET=standard
# APP_IMAGE=ghcr.io/koval01/telegram-me:latest
