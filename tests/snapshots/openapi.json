      "PowChallenge": {
        "description": "A proof-of-work challenge and how to answer it.",
        "properties": {
          "algorithm": {
            "description": "Hash function: `sha256`.",
            "title": "Algorithm",
            "type": "string"
          },
          "challenge": {
            "description": "Send back unchanged as `<challenge>:<nonce>`.",
            "title": "Challenge",
            "type": "string"
          },
          "difficulty": {
            "description": "Leading zero bits the SHA-256 hash must have.",
            "title": "Difficulty",
            "type": "integer"
          },
          "expires": {
            "description": "Unix time after which the challenge is rejected.",
            "title": "Expires",
            "type": "integer"
          },
          "header": {
            "description": "Request header that carries the answer: `X-PoW`.",
            "title": "Header",
            "type": "string"
          },
          "input": {
            "description": "What is hashed, with `\\n` as newlines; `target` is the request path and query exactly as sent.",
            "title": "Input",
            "type": "string"
          }
        },
        "required": [
          "challenge",
          "difficulty",
          "expires",
          "algorithm",
          "header",
          "input"
